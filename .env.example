# Шаблон переменных окружения: скопируйте в .env (он игнорируется git-ом).

# ── Сборка (npm run build) — значения вшиваются в dist/maps-config.js ──

# Ключи карт: видны любому посетителю в браузере, ограничивайте их по домену
# в кабинетах (Яндекс — Host/Referer, Mapbox — URL restrictions).
YANDEX_MAPS_KEY=
MAPBOX_ACCESS_TOKEN=

# Origin бэкенда, вшиваемый в статику. Пусто/не задан: на localhost /api
# проксируется serve-скриптом, на прочих доменах запросы идут напрямую на
# https://dtpstat-backend.7190805.xyz (CORS открыт). Для самостоятельного
# хостинга за nginx задайте свой домен с проксированием /api (см. README).
#API_ORIGIN=

# ── Локальный сервер (npm run serve) — в статику не попадает ──

#PORT=8080
#DTP_ORIGIN=https://dtpstat-backend.7190805.xyz
#DTP_CERT=
#DTP_KEY=
