# Шаблон переменных окружения: скопируйте в .env (он игнорируется git-ом).

# ── Сборка (npm run build) — значения вшиваются в dist/maps-config.js ──

# Ключи карт: видны любому посетителю в браузере, ограничивайте их по домену
# в кабинетах (Яндекс — Host/Referer, Mapbox — URL restrictions).
YANDEX_MAPS_KEY=
MAPBOX_ACCESS_TOKEN=

# Origin бэкенда API — ваш экземпляр dtpstat-map (https://github.com/dtpstat/dtpstat-map):
# вшивается в статику, страница ходит на него напрямую (CORS на бэкенде открыт).
# Пусто/не задан — запросы идут на /api того же origin: локально его проксирует
# serve-скрипт, на своём домене — nginx (см. README, «Самостоятельный хостинг»).
API_ORIGIN=

# ── Локальный сервер (npm run serve) — в статику не попадает ──

#PORT=8080
#DTP_ORIGIN=
#DTP_CERT=
#DTP_KEY=
