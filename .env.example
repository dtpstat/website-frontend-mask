# Шаблон переменных окружения: скопируйте в .env (он игнорируется git-ом).

# ── Конфиг развёртывания: значения пишутся в dist/maps-config.js ──
# (создать/пересоздать из .env — npm run config; файл правится и без пересборки)

# Ключи карт: видны любому посетителю в браузере, ограничивайте их по домену
# в кабинетах (Яндекс — Host/Referer, Mapbox — URL restrictions).
YANDEX_MAPS_KEY=
MAPBOX_ACCESS_TOKEN=

# Origin бэкенда API — ваш экземпляр dtpstat-map (https://github.com/dtpstat/dtpstat-map):
# вшивается в статику, страница ходит на него напрямую (CORS на бэкенде открыт).
# Пусто/не задан — запросы идут на /api того же origin: локально его проксирует
# serve-скрипт, на своём домене — nginx (см. README, «Самостоятельный хостинг»).
API_ORIGIN=

# ── Локальный сервер (npm run serve) — в статику не попадает ──

#PORT=8080
#DTP_ORIGIN=
#DTP_CERT=
#DTP_KEY=

# ── Публикация (scripts/deploy.sh; не включается в браузерный config) ──
# Cloudflare Pages: имя проекта и публичный адрес, независимые параметры.
DTP_CF_PAGES_PROJECT=dtpstat-pages
DTP_CF_PAGES_URL=https://dtpstat-pages.pages.dev
# SSH rsync цель и URL, по которому проверять зеркало после деплоя.
DTP_MIRROR_TARGET=dtpstat:dtpstat-pages/dist/
DTP_MIRROR_URL=https://ilia.dtp-stat.ru/map/
